{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1500,
  "latex-workshop.chktex.enabled": false,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 1000,
  "latex-workshop.latex.watch.files.interval": 1000,
  "latex-workshop.latex.watch.files.ignore": [
    "**/build/**",
    "**/*.pdf",
    "**/*.synctex.gz"
  ],
  "latex-workshop.latex.watch.usePolling": false,
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.search.rootFiles.include": [
    "/main.tex"
  ],
  "latex-workshop.latex.recipe.default": "xelatex (cepat)",
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex (cepat)",
      "tools": ["xelatex-fast"]
    },
    {
      "name": "xelatex x2",
      "tools": ["xelatex", "xelatex"]
    },
    {
      "name": "xelatex",
      "tools": ["xelatex"]
    },
    {
      "name": "latexmk (xelatex)",
      "tools": ["latexmk-xelatex"]
    },
    {
      "name": "xelatex -> bibtex -> xelatex x2",
      "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-output-directory=%OUTDIR%", "-include-directory=%OUTDIR%", "%DOC%"]
    },
    {
      "name": "xelatex-fast",
      "command": "xelatex",
      "args": ["-synctex=0", "-interaction=nonstopmode", "-file-line-error", "-output-directory=%OUTDIR%", "-include-directory=%OUTDIR%", "%DOC%"]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%OUTDIR%/%DOCFILE%"]
    },
    {
      "name": "latexmk-xelatex",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.synctex(busy)",
    "*.synctex.gz(busy)",
    "*.nav"
  ],
  "latex-workshop.view.pdf.auto": "onBuild",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.synctex.afterBuild.enabled": false,
  "latex-workshop.formatting.latex": "latexindent"
}
